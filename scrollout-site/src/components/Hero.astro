---
import Dots from './Dots.astro';
---

<section class="hero">
  <div class="hero-top-label mono">open source / android / gratuit</div>
  <h1 class="logo-text">Scroll<span class="o">o</span>ut</h1>

  <Dots />

  <h2 class="hero-hook">
    Tu scrolles.<br />
    L'algorithme choisit.<br />
    <span class="highlight">Tu ne vois rien.</span>
  </h2>

  <p class="hero-desc">
    Scrollout capture ce qu'Instagram te montre vraiment et te rend visible
    ce qui est invisible&nbsp;: les thèmes, la polarisation, les narratifs,
    ta bulle de filtre.
  </p>

  <div class="hero-actions">
    <a href="#manifeste" class="btn btn-black">Lire le manifeste</a>
    <a href="#fonctionnement" class="btn btn-ghost">Comment ça marche</a>
    <a href="https://gitlab.com/scrollout" class="btn btn-ghost" target="_blank" rel="noopener">Code source &rarr;</a>
  </div>

  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 80px 24px 40px;
  }

  .hero-top-label {
    color: var(--text-grey);
    margin-bottom: 24px;
  }

  .logo-text {
    font-size: clamp(4.5rem, 16vw, 10rem);
    margin-bottom: 0;
    letter-spacing: -0.03em;
  }

  .o {
    display: inline-block;
    color: var(--color-bleu-indigo);
  }

  .hero-hook {
    font-size: clamp(1.6rem, 5vw, 2.8rem);
    margin: 40px 0 32px;
    font-weight: 900;
    line-height: 1.35;
  }

  .hero-hook .highlight {
    color: var(--color-orange);
    display: block;
  }

  .hero-desc {
    max-width: 580px;
    color: var(--text-grey);
    font-size: 1.15rem;
    margin-bottom: 48px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .scroll-indicator {
    margin-top: 60px;
    display: flex;
    justify-content: center;
  }

  .scroll-line {
    width: 2px;
    height: 48px;
    background: linear-gradient(to bottom, var(--text-black), transparent);
    animation: pulse-down 2.5s ease-in-out infinite;
  }

  @keyframes pulse-down {
    0%, 100% { opacity: 0.2; transform: scaleY(0.6); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 60px 16px 40px;
    }

    .logo-text {
      font-size: clamp(3rem, 14vw, 5rem);
    }

    .hero-hook {
      font-size: 1.4rem;
      margin: 28px 0 24px;
    }

    .hero-desc {
      font-size: 1rem;
      margin-bottom: 32px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .scroll-indicator {
      margin-top: 40px;
    }
  }
</style>
